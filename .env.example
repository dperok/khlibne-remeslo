# Copy these keys to the root .env. Never prefix secrets with NEXT_PUBLIC_.
TELEGRAM_USER_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=470334534,5711475783
# Use a strong unique password. The real local value stays in the ignored .env.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# For public hosting, use your real HTTPS origin (no trailing slash).
PUBLIC_SITE_URL=http://localhost:3000
# Neon variables are already in .env.local; do not duplicate or commit them.
# Required for a Vercel deployment; generate independent random secrets.
ADMIN_SESSION_SECRET=
TELEGRAM_USER_WEBHOOK_SECRET=
TELEGRAM_ADMIN_WEBHOOK_SECRET=
CRON_SECRET=
# Optional locally. Vercel selects webhook mode automatically.
# TELEGRAM_MODE=webhook
# Existing personal integration key. Poster is accessed with GET requests only.
POSTER_API_TOKEN=
# Optional: restrict to one warehouse. Empty means totals across all warehouses.
POSTER_STORAGE_ID=
